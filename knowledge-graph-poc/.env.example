# kg-mapper-poc credentials (DESIGN §3.1). Copy to .env and fill in what you need.
# Nothing else belongs in this file; all other settings live in kg.yaml.

# Required only when kg.yaml has  llm.provider: openrouter
OPENROUTER_API_KEY=

# Required only when kg.yaml has  llm.provider: anthropic_api
# Leave this line commented out when using provider claude_subscription: the
# Claude Code CLI prefers an API key over the subscription login if one is set,
# and config.py refuses to start a claude_subscription run while it is present (D22).
# ANTHROPIC_API_KEY=
