# Socratic AI Tutor POC — copy to .env and edit. Never commit .env.
#
# The default setup needs NOTHING in this file: all three roles run on Anthropic
# and the SDK picks up the OAuth profile from `ant auth login`. Every setting
# below is an override.

# --- Per-role models (Addendum §1: Haiku classifies, Sonnet teaches) ---------
# POC_INTENT_MODEL=claude-haiku-4-5
# POC_EVALUATION_MODEL=claude-haiku-4-5
# POC_GENERATION_MODEL=claude-sonnet-5

# --- Per-role provider: anthropic | openai_compat | azure_foundry (R21) -----
# POC_INTENT_PROVIDER=anthropic
# POC_EVALUATION_PROVIDER=anthropic
# POC_GENERATION_PROVIDER=anthropic

# --- OpenAI-compatible endpoint (OpenRouter, Alibaba Model Studio) ----------
# Only needed when a role above is set to openai_compat.
# OpenRouter:              https://openrouter.ai/api/v1
# Alibaba Model Studio:    https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# POC_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# POC_OPENAI_COMPAT_API_KEY=
# POC_OPENAI_COMPAT_TIMEOUT_S=120

# --- Azure AI Foundry / Azure OpenAI (only needed when a role above is set to azure_foundry) ---
# POC_AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com
# POC_AZURE_FOUNDRY_API_KEY=
# POC_AZURE_FOUNDRY_DEPLOYMENT=<your-chat-deployment-name>
# POC_AZURE_FOUNDRY_API_VERSION=2024-10-21
# POC_AZURE_FOUNDRY_TIMEOUT_S=120

# --- Budgets ----------------------------------------------------------------
# POC_STRUCTURED_MAX_TOKENS=512
# POC_GENERATION_MAX_TOKENS=2000
# POC_INTENT_CONFIDENCE_THRESHOLD=0.6

# --- Retrieval ----------------------------------------------------------------
# POC_EMBEDDING_MODEL=BAAI/bge-m3

# --- Embeddings backend: local | azure_foundry ------------------------------
# POC_EMBEDDING_PROVIDER=local
# POC_EMBEDDING_AZURE_ENDPOINT=https://<your-resource>.openai.azure.com
# POC_EMBEDDING_AZURE_API_KEY=
# POC_EMBEDDING_AZURE_DEPLOYMENT=<your-embedding-deployment-name>
# POC_EMBEDDING_AZURE_API_VERSION=2024-10-21

# --- Paths (defaults are relative to the repo root) -------------------------
# POC_CONTENT_DIR=content
# POC_DATA_DIR=data
# POC_CHROMA_DIR=data/chroma
# POC_UPLOADS_DIR=data/uploads
