# Copy to .env and fill in real values. Used by azure_foundry_adapter.client.AzureFoundrySettings.from_env().
#
# Where to find these in the Azure Portal / Azure AI Foundry portal:
#   ENDPOINT     -> Foundry project / Azure OpenAI resource -> "Endpoint" (Keys and Endpoint blade)
#   API_KEY      -> same blade -> "KEY 1" or "KEY 2"
#   DEPLOYMENT   -> the *deployment name* you gave the model when you deployed it
#                   (Foundry -> Deployments), NOT the base model name (e.g. "gpt-4o")
#   API_VERSION  -> a supported Azure OpenAI API version, e.g. 2024-10-21 (GA) or a
#                   dated -preview version if you need a preview-only feature
#   API_STYLE    -> "azure_openai" for a classic Azure OpenAI resource
#                   (endpoint like https://<resource>.openai.azure.com), or
#                   "foundry_models" for an Azure AI Foundry resource using the
#                   unified Foundry Models inference endpoint
#                   (endpoint like https://<resource>.services.ai.azure.com)

AZURE_FOUNDRY_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=<your-deployment-name>
AZURE_FOUNDRY_API_VERSION=2024-10-21
AZURE_FOUNDRY_API_STYLE=azure_openai

# --- Per-project env vars, once you've wired the corresponding adapter in
# (see INTEGRATION.md) — these use each project's own naming convention, not
# this package's AZURE_FOUNDRY_* prefix.

# knowledge-graph-poc (kg.yaml: llm.provider: azure_foundry)
# AZURE_FOUNDRY_API_KEY is reused as-is (see INTEGRATION.md's _CREDENTIAL_FOR_PROVIDER change)

# socratic-tutor-poc (.env at socratic-tutor-poc/ root)
# POC_GENERATION_PROVIDER=azure_foundry
# POC_INTENT_PROVIDER=azure_foundry
# POC_EVALUATION_PROVIDER=azure_foundry
# POC_AZURE_FOUNDRY_ENDPOINT=https://<your-resource-name>.openai.azure.com
# POC_AZURE_FOUNDRY_API_KEY=
# POC_AZURE_FOUNDRY_DEPLOYMENT=<your-deployment-name>
# POC_AZURE_FOUNDRY_API_VERSION=2024-10-21

# --- socratic-tutor-poc embeddings, via shims/sentence_transformers (see
# INTEGRATION.md "Embeddings" section) — no POC_ prefix, these are read
# directly by the shim, not by socratic_tutor.config. ENDPOINT/API_KEY/
# API_VERSION/API_STYLE fall back to the plain AZURE_FOUNDRY_* ones above if
# unset, so usually only DEPLOYMENT needs setting here.
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=<your-embedding-deployment-name>
# AZURE_FOUNDRY_EMBEDDING_ENDPOINT=
# AZURE_FOUNDRY_EMBEDDING_API_KEY=
# AZURE_FOUNDRY_EMBEDDING_API_VERSION=
# AZURE_FOUNDRY_EMBEDDING_API_STYLE=
